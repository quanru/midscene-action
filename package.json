{
  "name": "midscene-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that runs Midscene YAML scripts on your own runner and reports results to the pull request",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "rstest",
    "test:u": "rstest -u",
    "lint": "biome check src tests scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^2.2.0",
    "@actions/cache": "^4.0.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/glob": "^0.5.0",
    "@actions/io": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@rstest/core": "0.11.5",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.8.3"
  }
}
